# Copy to backend/.env for local development. Never commit backend/.env.

# TomTom API key (routing, geocoding and place suggestions): https://developer.tomtom.com
TOMTOM_API_KEY=

# Django. In production set a long random DJANGO_SECRET_KEY and leave DJANGO_DEBUG unset.
# With DJANGO_DEBUG=1 an insecure development key is used when DJANGO_SECRET_KEY is empty.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1

# Comma-separated host names. On Vercel, *.vercel.app hosts are added automatically.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
